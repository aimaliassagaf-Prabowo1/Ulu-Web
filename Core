  if (o.usedPts) L.push(`Subtotal: ${rp(o.subtotal)}`, `Pakai poin: ${o.usedPts} (-${rp(o.discount)})`);
  L.push(`TOTAL: ${rp(o.total)}`, `Pembayaran: ${o.payment === 'QRIS' ? 'QRIS' : 'CASH saat ambil'}`, `Ambil: ${LOKASI}`);
