@keyframes uIn{from{opacity:0;transform:translate(-50%,-50%) scale(.3) rotate(-14deg)}}
@keyframes uOut{to{opacity:0;visibility:hidden}}
@keyframes uUp{to{opacity:0;visibility:hidden;transform:translate(-50%,-160%) scale(.8)}}
#sprog{position:fixed;top:0;left:0;width:100%;height:5px;z-index:55;transform-origin:0 50%;transform:scaleX(0);
