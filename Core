  if (q < 0) return;
  if (q > stockOf(m)){ toast(stockOf(m) ? `Stok ${m.title} tinggal ${stockOf(m)}` : `${m.title} sedang habis`); return; }
  if (q > 20) return;
  cart[id] = q; renderCart(); if (q) $('e-cart').classList.remove('show');
