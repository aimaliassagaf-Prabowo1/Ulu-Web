async function submitOrder(e){
  e.preventDefault(); if (busy) return;
  const name = $('o-name').value.trim(), phone = $('o-phone').value.trim(),
        email = $('o-email').value.trim(), note = $('o-note').value.trim();
  let ok = true;
  const flag = (id, bad) => { $(id).classList.toggle('show', bad); if (bad) ok = false; };
  flag('e-cart', !cartItems().length); flag('e-name', !name);
  flag('e-phone', !!phone && !validPhone(phone)); flag('e-email', !!email && !validEmail(email));
  if (!ok){ toast('Cek lagi isian yang merah ya!'); return; }
  busy = true; $('o-submit').disabled = true;
  try {
    await fresh('menu','orders','points','settings');
    const items = cartItems();
    for (const it of items){
      const m = byId(it.id);
      if (!m || stockOf(m) < it.qty){
        if (m) cart[m.id] = stockOf(m); else delete cart[it.id];
        toast(m ? `Stok ${m.title} tinggal ${stockOf(m)}, ubah jumlahnya ya` : `${it.title} sudah tidak tersedia`);
        renderAll(); renderCart(); return;
      }
    }
    if (payMethod === 'QRIS' && !S.settings.qris) payMethod = 'Cash';
    const c = calc();
    items.forEach(it => { const m = byId(it.id); m.stock = stockOf(m) - it.qty; });
    if (c.mid){
      const p = S.points[c.mid] || (S.points[c.mid] = {name, pts:0});
      p.name = name; p.pts = Math.max(0, p.pts - usePts);
    }
    const o = { id:'ULU-' + Date.now().toString(36).toUpperCase().slice(-5), name, phone, email, note, items,
                subtotal:c.sub, usedPts:usePts, discount:c.disc, total:c.total, earnedPts:c.earn, member:c.mid, credited:false,
                payment:payMethod, emailSent:false, status:'Menunggu', date:today() };
    S.orders.unshift(o);
    await Promise.all([save('menu'), save('orders'), save('points')]);
    renderAll(); closeM('m-order'); showReceipt(o);
  } finally { busy = false; $('o-submit').disabled = false; }
}
function orderText(o){
