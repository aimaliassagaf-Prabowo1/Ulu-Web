  });
  document.querySelectorAll('.sec-head,.ptscard,.annbar').forEach(el => { el.classList.add('rv'); io.observe(el); });
  const title = document.querySelector('.p-title'); let li = 0;
  title.setAttribute('aria-label', 'Ulumunch Menu');
  (function split(el){
    [...el.childNodes].forEach(n => {
      if (n.nodeType === 3 && n.textContent.trim()){
        const f = document.createDocumentFragment();
        [...n.textContent].forEach(ch => {
