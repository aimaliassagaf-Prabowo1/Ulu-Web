function calc(){
  const sub = cartTotal();
  const mid = memberId($('o-phone').value.trim(), $('o-email').value.trim());
  const bal = mid && S.points[mid] ? S.points[mid].pts : 0;
  const maxUse = Math.min(bal, Math.floor(sub / POINT_VALUE));
  usePts = Math.max(0, Math.min(usePts, maxUse));
  const disc = usePts * POINT_VALUE, total = sub - disc;
  return {sub, mid, bal, maxUse, disc, total, earn: mid ? Math.floor(total / POINT_EVERY) : 0};
}
