.rv{transition:opacity .8s ease,transform .8s cubic-bezier(.2,1.2,.4,1)}
.rv:not(.in){opacity:0;transform:translateY(40px)}
.rv-group:not(.in) > *{opacity:0}
.rv-group.in:not(.done) > *{animation:uRise .7s cubic-bezier(.2,1.3,.4,1) backwards;animation-delay:calc(var(--d,0) * 90ms)}
.rv-group > *:nth-child(even){--rr:2deg}
@keyframes uRise{from{opacity:0;transform:translateY(46px) scale(.94) rotate(var(--rr,-2deg))}}
.ripple{position:absolute;border-radius:50%;background:currentColor;opacity:.3;transform:scale(0);pointer-events:none;animation:uRip .6s ease-out forwards}
@keyframes uRip{to{transform:scale(1);opacity:0}}
.hero-btns .btn-dark::after,.hdr-right .btn-purple::after,.fab-order::after,#o-submit::after,#r-mail::after{
  content:'';position:absolute;top:0;bottom:0;width:40%;left:-60%;pointer-events:none;
